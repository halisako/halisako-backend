# Copy to .env for local development. On Render, set these as
# environment variables in the service's dashboard instead — .env files
# aren't used in production.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,https://halisako.com

# --- AI provider ---
# "template" needs no credentials and is the safe default — the service
# works immediately with this. Switch to a real provider once you've
# set the matching API key below.
AI_PROVIDER=template
# AI_PROVIDER=openai
# AI_PROVIDER=anthropic
# AI_PROVIDER=gemini
# AI_PROVIDER=local

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic — https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# Local / self-hosted model server (e.g. Ollama). No key needed.
# LOCAL_MODEL_URL=http://localhost:11434/api/generate
# LOCAL_MODEL=llama3
